	// Score parts (spec 2590, 2591). The part names are in HotCargoBreakdown (mod/ux/strings.en.rules).
	ScoreTipFmt = "Score {0}"
	ScoreNoParts = "This run was recorded before scores kept their parts."
	ScoreLost = "A lost run scores 0."
