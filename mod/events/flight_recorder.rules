// Flight Recorder: The Black Box chain's cargo (spec 1100, 1107). Normal storage holds it, one to a storage slot. Stations do not trade it.
ID = yarden_zamir.flight_recorder
NameKey = "HotCargoEventMissions/FlightRecorder"
PluralNameKey = "HotCargoEventMissions/FlightRecorderPlural"
DescriptionKey = "HotCargoEventMissions/FlightRecorderDesc"
// Never traded; 1, not 0, because some vanilla code divides by it.
BuyPrice = 1
MaxPerNugget = 1
MaxStackSize = 1
// Shares the processor key, so storage parts get no extra supply job.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
// A hit on its storage destroys the recorder half of the time; otherwise it drifts loose and the crew can pick it up.
DropRates
{
	StorageDestroyed = 50%
	StorageSalvaged = 100%
	CrewKilled = 100%
}
Rarity = Unique

// Own art, drawn by tools/sprites/make_items.py.
Icon = &<sprites/flight_recorder/sprites.rules>/Icon
Overlay = &<sprites/flight_recorder/sprites.rules>/Overlay
NuggetSprite = &<sprites/flight_recorder/sprites.rules>/NuggetSprite
StackSprites = &<sprites/flight_recorder/sprites.rules>/StackSprites

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup
