		// Spec 2270: the effects stay off the buttons, or a wrong answer would show its heat.
		HideEffects = true
		Trigger = Arrival
		Weight = 1
		Need { MinHeat = 10; NotFlags = [riddle_met] }
		Carrier = RiddleShip
		Title = "Riddle Ship"
		Text = "A painted ship hails you. Its captain grins. \"Answer my riddle, and I talk to my contacts for you. What has to be broken before you can use it?\""
		Choices
		[
			{
				Text = "A vow."
				Outcomes [ { Text = "\"Wrong!\" They tell the story on an open channel, with your ship's name in it."; Heat = 3; SetFlags = [riddle_met] } ]
			}
			{
				Text = "An egg."
