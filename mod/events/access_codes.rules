// Corporate Access Codes (spec 1115): the usual contents of a Sealed Case. Sell them at a station (codes_fence in events.rules).
ID = yarden_zamir.access_codes
NameKey = "HotCargoItems/AccessCodes"
PluralNameKey = "HotCargoItems/AccessCodesPlural"
DescriptionKey = "HotCargoItems/AccessCodesDesc"
// Never traded at a station; 1, not 0, because some vanilla code divides by it.
BuyPrice = 1
MaxPerNugget = 1
MaxStackSize = 1
// Shares the processor key, so storage parts get no extra supply job.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
// A hit on its storage destroys the unit half of the time; otherwise it drifts loose and the crew can pick it up.
DropRates
{
	StorageDestroyed = 50%
	StorageSalvaged = 100%
	CrewKilled = 100%
}
Rarity = Unique

// Own art, drawn by tools/sprites/make_items.py.
Icon = &<sprites/access_codes/sprites.rules>/Icon
Overlay = &<sprites/access_codes/sprites.rules>/Overlay
NuggetSprite = &<sprites/access_codes/sprites.rules>/NuggetSprite
StackSprites = &<sprites/access_codes/sprites.rules>/StackSprites

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup
