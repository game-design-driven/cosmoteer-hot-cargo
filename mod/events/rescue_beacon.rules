// Rescue Beacon (spec 1147): fire it to call a tug that tows the ship to the nearest friendly station, for a fee and some heat.
// Trade stations stock it and sell it in their trade window (events/actions.rules); RescueBeacon.cs sets its price.
ID = yarden_zamir.rescue_beacon
NameKey = "HotCargoItems/RescueBeacon"
PluralNameKey = "HotCargoItems/RescueBeaconPlural"
DescriptionKey = "HotCargoItems/RescueBeaconDesc"
// Not the price: RescueBeacon.cs sets it (Events.RescueBeaconPrice money units). 1, not 0, because some vanilla code divides by it.
BuyPrice = 1
MaxPerNugget = 1
MaxStackSize = 1
// Shares the processor key, so storage parts get no extra supply job.
FlexGridPriorityKey = "flex_grid_processor"
FlexGridDefaultPriority = 1
DropRates
{
	StorageDestroyed = 50%
	StorageSalvaged = 100%
	CrewKilled = 100%
}
Rarity = Unique

// Own art, drawn by tools/sprites/make_items.py.
Icon = &<sprites/rescue_beacon/sprites.rules>/Icon
Overlay = &<sprites/rescue_beacon/sprites.rules>/Overlay
NuggetSprite = &<sprites/rescue_beacon/sprites.rules>/NuggetSprite
StackSprites = &<sprites/rescue_beacon/sprites.rules>/StackSprites

StackReceiveMediaEffects = &/COMMON_EFFECTS/ProcessorDeliver
StackPickupMediaEffects = &/COMMON_EFFECTS/ProcessorPickup
NuggetPickupMediaEffects = &/COMMON_EFFECTS/NuggetPickup

// Spec 1146, 1147: the C# handler (Events/RescueBeacon.cs) runs the rescue; the button tooltip shows the fee and the heat.
HotCargoActions
[
	{
		ID = fire
		NameKey = "HotCargoItems/FireRescue"
		ToolTipKey = "HotCargoItems/FireRescueTip"
		Handler = rescue
	}
]
