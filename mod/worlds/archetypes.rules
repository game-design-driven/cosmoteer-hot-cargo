// System types of the Hot Cargo run map (spec 220). mod/journey/galaxy.rules uses this spawner instead of the vanilla one.
// It is the vanilla RandomSectorTypes spawner: each system that has no sector type yet gets one by weight.
// The starting system stays basic (StartingNodePicker in galaxy.rules sets it first).
// The weights are the tunables Worlds.SystemTypeWeights (spec 1983): Journey/MapRules.cs writes them here when a new galaxy is
// made. This file holds the types and their tier limits.

SectorTypes
{
	Type = RandomSectorTypes
	SectorTypes
	[
		// Hot Cargo archetypes (worlds/sectors.rules).
		{
			Type = hc_trade_hub
		}
		{
			Type = hc_mining_belt
		}
		{
			Type = hc_solar_zone
		}
		{
			Type = hc_deep_space
			MinTier = 3
		}

		// Vanilla sector types (their default weights are lower than in base_galaxy.rules).
		{
			Type = basic
		}
		{
			Type = binary
		}
		{
			Type = high_density_nebula
			MinTier = 5
		}
		{
			Type = supernova
			MinTier = 5
		}
		{
			Type = electron
		}
	]
}
