// Tech Vault (spec 15, 440, 1540). One tile with a single-type grid for Stolen Tech. Own art in sprites/tech_vault (spec 2005).
// The copy is on purpose: inheriting storage_2x2 would merge its FlexResourceGrid, which accepts any resource.
Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "HotCargoTech/TechVault"
	IconNameKey = "HotCargoTech/TechVaultIcon"
	ID = yarden_zamir.tech_vault
	EditorGroup = "Storage"
	DescriptionKey = "HotCargoTech/TechVaultDesc"
	JobsNameKey = "Parts/StorageGeneric"
	SelectionTypeID = "yarden_zamir.tech_vault"
	Resources
	[
		// Spec 447: as cheap as 1x1 armor (8 steel, 4,000 health), so an empty vault is easy to rebuild but is no cheaper armor.
		[steel, 8]
	]
	Size = [1, 1]
	IsRotateable = false
	// Three times a vanilla storage tile (the 2x2 bay has 4,000 for 4 tiles), below 1x1 armor (4,000). Spec 65: only destruction costs tech.
	MaxHealth = 3000
	TypeCategories = [storage]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	IgnoreRotationForMirroredSelection = true
	EditorIcon
	{
		Texture
		{
			File = "sprites/tech_vault/icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = CommandToggle
		}

		// 1 tile x MaxStackSize 4 = 4 units (spec 1540). The code reads the capacity from this grid.
		Storage
		{
			Type = TypedResourceGrid
			ResourceType = yarden_zamir.stolen_tech
			GridRect = [0, 0, 1, 1]
			Layer = "doodads_low"
			SpriteInset = 8/64
			// The part cost counts InitToMaxResources x BuyPrice, and a new ship spawns filled to it. Tech comes only from the run start.
			InitToMaxResources = 0
			IsDrainable = false
			AllowExternalPickupAndDelivery = true
		}
		// Registers the tile as a sink, so crew put carried tech and tech from normal storage into a vault first (spec 1543).
		// The vanilla consumption toggle (Resources view, like a chaingun magazine) turns the fill of this vault on and off (spec 1546).
		StorageConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = yarden_zamir.stolen_tech
			Storage = Storage
			DefaultPriority = &/PRIORITIES/Storage_Supply
			ConsumptionToggleButtonOffset = [0, -.4]
			// No part supplies tech: crew bring it. Without this the build tool marks every vault "No Stolen Tech" (BaseBuildState.GetCrewPathInfo).
			AccessWarningLevel = None
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			// Own art (tools/sprites/make_sprites.py): an armoured bed with a pad under each unit, and a heavy frame.
			Floor
			{
				Layer = "floors"
				DamageLevels [
					{ File = "sprites/tech_vault/floor.png"; Size = [1, 1] }
					{ File = "sprites/tech_vault/floor_33.png"; Size = [1, 1] }
					{ File = "sprites/tech_vault/floor_66.png"; Size = [1, 1] }
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels [ { File = "./Data/ships/terran/darkness/darkness1x1.png"; Size = [1, 1] } ]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels [ { File = "sprites/tech_vault/lights.png"; Size = [1, 1] } ]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels [
					{ File = "sprites/tech_vault/walls.png"; Size = [1, 1] }
					{ File = "sprites/tech_vault/walls_33.png"; Size = [1, 1] }
					{ File = "sprites/tech_vault/walls_66.png"; Size = [1, 1] }
				]
			}
		}

		// No roof (the storage bay has one): a closed roof hid the items, so a full vault looked empty (spec 1540).

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyedDry
			Location = [0.5, 0.5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "sprites/tech_vault/blueprints.png"
			Size = [1, 1]
		}
	}

}
