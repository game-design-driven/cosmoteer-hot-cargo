// Icon of the Weld build tool (spec 2480), drawn by tools/sprites/make_ui_icons.py. Read by Weld/WeldTool.cs.
// Same texture settings as the vanilla build tool icons (gui/game/designer/build_gui.rules, RemovePartSprite).
Tool
{
	Texture
	{
		File = "sprites/tool_weld.png"
		MipLevels = 2
		SampleMode = Linear
	}
}
