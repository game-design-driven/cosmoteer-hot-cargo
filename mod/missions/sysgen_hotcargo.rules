// Hot Cargo mission offers. Added to the end of the sector system generator by mod/missions/actions.rules,
// so all vanilla stations, bases and bounties exist when these spawners run.
// Each group has a hc_group_* tag. The autotest command hc_generate finds the groups by that tag.
Type = None
SubSpawners
[
	&~/Escort
	&~/BlindCourier
	&~/FleetAssault
	&~/ShadyBounty
]

// Spec 1890 to 1897. The Blind Courier: a small unarmed courier with a dead navigation core waits next to a trade station. After the
// players answer its hail, it follows their nearest ship. The players lead it to a jump point on the convoy route rules (spec 36).
// The objective (Missions/LeadObjective.cs) spawns the courier (Missions/CourierShip.cs), moves the jump point onto the route,
// sends the ambushes, and runs the escort guard rule (spec 1881 to 1885).
BlindCourier
{
	Type = None
	// hc_own_stream (spec 1897): its rolls come from its own random stream, so adding it moved no roll of any other system object.
	Tags = [hc_group_lead, hc_own_stream]
	// BALANCE.md, finding 10: no Hot Cargo type in more than half of the systems.
	SpawnChance = 50%
	RootLocation = Tag
	RootLocationTag = trade_station

	SubSpawners
	[
		// The jump point. Its direction from the station is the first route that the objective tries. The objective reveals it on acceptance.
		{
			Type = Doodads
			DoodadType = cosmoteer.poi_target_area
			ScaleFactor = 500
			Tags = [hc_lead_dest]
			Distance = [4500, 6500]
			MinDistanceFromTags = [[sun, "max((&<../contracts/system_scale.rules>/Scale) * 6000, (&<../contracts/system_scale.rules>/SunClearance))"], [station, "(&<../contracts/system_scale.rules>/Scale) * 3000"], [bounty, "(&<../contracts/system_scale.rules>/Scale) * 2000"]]
			MinDistanceFromNebulas = [[ion_storm, 1000]]
			Undiscovered = true
			HideIfUnexplored = true
			ShowOnlyInFog = true
			SuppressLocationAssertions = true
		}
		{
			Type = Mission
			Metatype = HotCargoLead
			SpawnAt = Tag
			SpawnAtTag = { Mode=Nearest; Tag=trade_station; }
			Faction = OwnerOfTag
			FactionTag = { Mode=Nearest; Tag=trade_station; }
			Objectives
			[
				{
					Type = Sequential
					SubObjectives
					[
						{
							Type = HotCargoLead
							DestinationTag = { Mode=Latest; Tag=hc_lead_dest; }
							StationTag = { Mode=Nearest; Tag=trade_station; }
							// Spec 1886: a weak ship that follows the players the whole way, so a short 3 minutes alone.
							LostSeconds = 180
							// The route keeps the route sun clearance of the smaller systems (spec 36, spec 105).
							SunClearance = "(&<../contracts/system_scale.rules>/RouteSunClearance)"
						}
						{
							Type = ReceiveRewards
						}
					]
				}
			]
			// Like Convoy Duty (BALANCE.md, finding 10): 2x money, fame and reputation. The ambush raiders also pay kill fame.
			Rewards
			[
				{
					Type = Money
					MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
					MoneyPerTierMultiplier = 2
					RoundToMultiple = 500
				}
				{
					Type = Fame
					FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
					MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
					FamePerTierMultiplier = 2
				}
				{
					Type = Reputation
					ReputationPerHighTier = &/TIER_TABLES/StandardReputationPerTier
					ReputationPerTierMultiplier = 2
				}
				// Spec 100: a legal courier job, quiet like a convoy. It leaves only half a trail.
				{
					Type = HotCargoContract
					TrailWeight = 0.5
				}
			]
		}
	]
}

// Spec 36. A civilian freighter waits next to a station. After the players accept, it flies to a jump point in open space.
// The escort objective moves the jump point to MissionTunables.EscortRouteShare of the gate ring and spawns the raiders
// on the route (missions/convoy_ambush.rules). The freighter moves only while a player is near it (ships far from players are in stasis).
Escort
{
	Type = None
	Tags = [hc_group_escort]
	// BALANCE.md, finding 10: no Hot Cargo type in more than half of the systems, and as many as that allows (was 45%, before that 60%).
	SpawnChance = 50%
	RootLocation = Tag
	RootLocationTag = trade_station

	SubSpawners
	[
		// The jump point. Its direction from the station is the first route that the escort objective tries. The objective reveals it on acceptance.
		{
			Type = Doodads
			DoodadType = cosmoteer.poi_target_area
			ScaleFactor = 500
			Tags = [hc_escort_dest]
			Distance = [4500, 6500]
			MinDistanceFromTags = [[sun, "max((&<../contracts/system_scale.rules>/Scale) * 6000, (&<../contracts/system_scale.rules>/SunClearance))"], [station, "(&<../contracts/system_scale.rules>/Scale) * 3000"], [bounty, "(&<../contracts/system_scale.rules>/Scale) * 2000"]]
			MinDistanceFromNebulas = [[ion_storm, 1000]]
			Undiscovered = true
			HideIfUnexplored = true
			ShowOnlyInFog = true
			SuppressLocationAssertions = true
		}

		// The freighter. Its AI has no strategy modules; the escort objective gives its move orders.
		{
			Type = Ships
			Tags = [hc_escort_ship]
			Distance = [500, 800]
			Allegiance = FactionCivilian
			SuppressLocationAssertions = true
			ShipCriteria
			{
				UseLocalFactionWeights = true
				UseTierField = true
				AllowTierRangeExpansion = true
				Tags = [trade]
			}
			AI
			{
				Type = HotCargoFreighter
				ChanceToConsiderSurrenderingToPlayer = 0
			}

			SubSpawners
			[
				{
					Type = Mission
					Metatype = HotCargoEscort
					SpawnAt = Tag
					SpawnAtTag = { Mode=Nearest; Tag=trade_station; }
					Faction = OwnerOfTag
					FactionTag = { Mode=Latest; Tag=hc_escort_ship; }
					OkayIfFactionTagNotFound = true
					Objectives
					[
						{
							Type = Sequential
							SubObjectives
							[
								{
									// ProtectShips starts completed and only fails, so it must sit next to real work.
									Type = AnyOrder
									SubObjectives
									[
										{
											Type = HotCargoEscort
											EscortTag = { Mode=Latest; Tag=hc_escort_ship; }
											DestinationTag = { Mode=Latest; Tag=hc_escort_dest; }
											// The route keeps the route sun clearance of the smaller systems (spec 36, spec 105).
											SunClearance = "(&<../contracts/system_scale.rules>/RouteSunClearance)"
											// Spec 1886: a route of about 9,000; 4 minutes alone (the default) before raiders take it.
											LostSeconds = 240
										}
										{
											Type = ProtectShips
											TargetsTag = { Tag=hc_escort_ship; Max=1; }
										}
									]
								}
								{
									Type = ReceiveRewards
								}
							]
						}
					]
					// 2x money and fame, like a vanilla station rescue (BALANCE.md, finding 10). The raiders also pay kill fame.
					Rewards
					[
						{
							Type = Money
							MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
							MoneyPerTierMultiplier = 2
							RoundToMultiple = 500
						}
						{
							Type = Fame
							FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
							MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
							FamePerTierMultiplier = 2
						}
						{
							Type = Reputation
							ReputationPerHighTier = &/TIER_TABLES/StandardReputationPerTier
							ReputationPerTierMultiplier = 2
						}
						// Convoy cover: MissionTunables.EscortHeatChange (spec 36).
						{
							Type = HotCargoEscortCover
						}
						// Spec 100: a registered convoy is a quiet, legal job. It leaves only half a trail. Fee and informant use the normal roll.
						{
							Type = HotCargoContract
							TrailWeight = 0.5
						}
					]
				}
			]
		}
	]
}

// Spec 37. A raider stronghold (the vanilla pirate base shape) and an allied faction strike group that attacks it.
// The strike group is a sibling of the stronghold, not a child, because the stronghold synchronizes allegiance to its children.
FleetAssault
{
	Type = None
	Tags = [hc_group_assault]
	// BALANCE.md, finding 10: 50% (was 30%, before that 40%).
	SpawnChance = 50%

	SubSpawners
	[
		: <./Data/modes/career/sectors/sysgen_military_stations.rules>/BaseMilitaryStation
		{
			Tags = [station, military_station, hc_assault_station]
			Features = [Landmark, HideUntilDiscovered]
			Allegiance = Unique
		}

		// Rally point of the strike group, away from the stronghold.
		{
			Type = None
			Tags = [hc_assault_rally]
			RootLocation = Tag
			RootLocationTag = hc_assault_station
			Distance = [2800, 3400]
			MinDistanceFromTags = [[sun, "max((&<../contracts/system_scale.rules>/Scale) * 5000, (&<../contracts/system_scale.rules>/SunClearance))"]]
			MinDistanceFromNebulas = [[ion_storm, 1000]]
			SuppressLocationAssertions = true
			SynchronizeFactions = true

			SubSpawners
			[
				// Faction military: friendly to the players, hostile to the Unique stronghold.
				// Their AI origin is the stronghold. Out of stasis, they fly in and attack it.
				{
					Type = Ships
					Tags = [hc_assault_ally]
					Count = [2, 3]
					Distance = [0, 250]
					Allegiance = FactionMilitary
					SuppressLocationAssertions = true
					ShipCriteria
					{
						UseLocalFactionWeights = true
						UseTierField = true
						AllowTierRangeExpansion = true
						Tags = [combat]
					}
					AI
					{
						Type = Normal
						ChanceToConsiderSurrenderingToPlayer = 0
						PatrolOriginTag = { Mode=Latest; Tag=hc_assault_station; }
						PatrolRadius = 600
						TargetAcquireRangeFromOrigin = 1800
						TargetUnacquireRangeFromOrigin = 2600
					}
				}
			]
		}

		// The contract. It runs after the strike group, so the mission takes the strike group's faction.
		{
			Type = None
			RootLocation = Tag
			RootLocationTag = hc_assault_station

			SubSpawners
			[
				{
					Type = Mission
					Metatype = HotCargoFleetAssault
					SpawnAt = Tag
					SpawnAtTag = { Mode=Nearest; Tag=trade_station; }
					Faction = OwnerOfTag
					FactionTag = { Mode=Latest; Tag=hc_assault_ally; }
					OkayIfFactionTagNotFound = true
					Objectives
					[
						{
							Type = Sequential
							SubObjectives
							[
								{
									Type = DefeatShips
									TargetsTag = { Tag=hc_assault_station; Max=1; }
									TargetAreaTag = { Mode=Nearest; Tag=poi_unknown; }
									TierOffset = 1
									AutoDiscoverTargetArea = true
									AllowSurrender = false
								}
								{
									Type = ReceiveRewards
								}
							]
						}
					]
					// A vanilla pirate base pays 2x, and so does this (BALANCE.md, finding 10). The strike group helps, but it takes a whole fleet.
					Rewards
					[
						{
							Type = Money
							MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
							MoneyPerTierMultiplier = 2
							RoundToMultiple = 1000
						}
						{
							Type = Fame
							FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
							MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
							FamePerTierMultiplier = 2
						}
						{
							Type = Reputation
							ReputationPerHighTier = &/TIER_TABLES/StandardReputationPerTier
							ReputationPerTierMultiplier = 3
						}
						// Spec 100: a navy strike is loud (flat heat). The navy does not sell its jobs and does not talk.
						{
							Type = HotCargoContract
							AcceptFee = 0
							FlatHeat = 5
							InformantChance = 0
						}
					]
				}
			]
		}
	]
}

// Spec 38 to 40. Looks like a vanilla fugitive bounty, with these tells: no faction seal (no reputation),
// money x ShadyRewardFactor, and odd wording. The trap objective rolls when the players reach the target.
ShadyBounty
{
	Type = None
	Tags = [hc_shady, hc_group_shady]
	// BALANCE.md, finding 10: 50%, at most every other system (was 60%, before that 70% and 1 to 2 offers). Distance and gaps follow the vanilla bounties (contracts/system_scale.rules).
	SpawnChance = 50%
	Count = 1
	Distance = [0, "(&<../contracts/system_scale.rules>/Scale) * 19000"]
	// hc_shady belongs to this None spawner and leaves no object, so a later spawn keeps its gap from the target ship instead.
	MinDistanceFromTags = [[sun, "max((&<../contracts/system_scale.rules>/Scale) * 6000, (&<../contracts/system_scale.rules>/SunClearance))"], [station, "(&<../contracts/system_scale.rules>/Scale) * 4000"], [bounty, "(&<../contracts/system_scale.rules>/Scale) * 6000"], [hc_shady, "(&<../contracts/system_scale.rules>/Scale) * 6000"], [hc_shady_ship, "(&<../contracts/system_scale.rules>/Scale) * 6000"]]
	MinDistanceFromNebulas = [[ion_storm, 1000]]
	SuppressLocationAssertions = true

	SubSpawners
	[
		{
			Type = Ships
			Tags = [hc_shady_ship]
			Allegiance = Unique
			FamePerTier = &/TIER_TABLES/StandardFamePerTier
			MaxFamePerTier = &/TIER_TABLES/StandardMaxFamePerTier
			ShipCriteria
			{
				UseLocalFactionWeights = true
				UseTierField = true
				AllowTierRangeExpansion = true
				Tags = [combat]
				UseEvenShipTypeDistribution = true
			}
			AI
			{
				Type = Normal
				ChanceToConsiderSurrenderingToPlayer = 0
				PatrolRadius = 1000
				TargetAcquireRangeFromOrigin = 3000
				TargetUnacquireRangeFromOrigin = 4000
			}

			SubSpawners
			[
				{
					Type = Doodads
					Distance = [0, (&../ScaleFactor) - (&../../../AI/PatrolRadius)]
					ScaleFactor = 2250
					Tags = [hc_shady_area, poi_unknown]
					DoodadType = cosmoteer.poi_target_area
					ShowOnlyInFog = true
					Undiscovered = true
					HideIfUnexplored = true
					AutoRemoveWhenTagDestroyed = hc_shady_ship
				}
				{
					Type = Mission
					Metatype = HotCargoShadyBounty
					SpawnAt = Tag
					SpawnAtTag = { Mode=Nearest; Tag=trade_station; }
					Faction = None
					Objectives
					[
						{
							Type = Sequential
							SubObjectives
							[
								{
									Type = AnyOrder
									SubObjectives
									[
										{
											Type = DefeatShips
											TargetsTag = { Tag=hc_shady_ship; Max=1; }
											TargetAreaTag = { Mode=Latest; Tag=hc_shady_area; }
											AutoDiscoverTargetArea = true
											AllowSurrender = false
										}
										{
											Type = HotCargoShadyTrap
											SiteShipTag = { Mode=Latest; Tag=hc_shady_ship; }
											TriggerDistance = 2500
											SurvivalRewards
											[
												{
													Type = HotCargoScaled
													Tunable = ShadyTrapSurvivalReward
													RoundToMultiple = 500
													Reward
													{
														Type = Money
														MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
														RoundToMultiple = 500
													}
												}
												{
													Type = HotCargoScaled
													Tunable = ShadyTrapSurvivalReward
													Reward
													{
														Type = Fame
														FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
														MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
													}
												}
											]
										}
									]
								}
								{
									Type = ReceiveRewards
								}
							]
						}
					]
					Rewards
					[
						{
							Type = HotCargoScaled
							Tunable = ShadyRewardFactor
							RoundToMultiple = 500
							Reward
							{
								Type = Money
								MoneyPerHighTier = &/TIER_TABLES/StandardMoneyPerTier
								RoundToMultiple = 500
							}
						}
						{
							Type = Fame
							FamePerHighTier = &/TIER_TABLES/StandardFamePerTier
							MaxFamePerHighTier = &/TIER_TABLES/StandardMaxFamePerTier
						}
						// Spec 100: an illegal hit. The client wants buy-in money, and the job is noisy.
						// No informant roll: the trap (spec 39) is this offer's own sell-out.
						{
							Type = HotCargoContract
							AcceptFee = 0.5
							FlatHeat = 4
							InformantChance = 0
						}
					]
				}
			]
		}
	]
}
