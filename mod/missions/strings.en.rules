HotCargoMissions
{
	Escort = "Convoy Duty"
	EscortDesc = "Escort the freighter {escort_ship} to the jump point.\nRaiders know the route. Stay close: it waits for you, and alone it draws raiders. After 4 minutes alone, raiders take it."
	EscortCoverFmt = "Heat {0} (convoy cover)"
	EscortCoverTip = "Flying in a registered convoy hides your trail. Heat changes when you collect the reward."
	FleetAssault = "Joint Strike"
	FleetAssaultDesc = "Join the navy strike group and destroy the raider stronghold."
	ShadyBounty = "Discreet Bounty"
	ShadyBountyDesc = "Destroy the <b>{target_ship}</b>. No faction, no questions.\nIt can be a corporate trap."
}

HotCargoObjectives
{
	EscortFmt = "Escort {0} to the jump point"
	EscortMeetFmt = "Meet {0}. It comes to you"
	EscortAnswerFmt = "Answer the hail of {0} when you are ready"
	EscortHailedFmt = "{0} hails you: ready to leave?"
	EscortDepartsFmt = "{0} is under way. Stay close."
	// Spec 1881 to 1886: the guard rule of an escort under way.
	EscortAloneFmt = "{0} alone: lost in {1}. Stay close"
	EscortRaidedFmt = "Raiders found {0}: lost in {1}. Get back to it"
	EscortAloneStartFmt = "{0} is alone and waits for you. Lost in {1}"
	EscortAloneWarnFmt = "{0} is still alone. Lost in {1}"
	EscortAloneMarker = "Escort alone"
	EscortRaidFmt = "{0}: raiders on our scope! Where are you?"
	EscortLostFmt = "Contact lost with {0}. Raiders took it while it waited alone."
	SurviveAmbush = "Survive the ambush"
	TrapSprung = "It was a setup. Corporate hunters drop out of the dark!"
}

// Spec 1852: the comms page of a waiting escort.
HotCargoEscortHail
{
	Ask = "\"We are fueled and loaded. Ready to leave?\""
	Ready = "Ready. Lead the way."
	NotYet = "Not yet. Hold here."
}
