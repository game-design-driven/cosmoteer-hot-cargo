// Hot Cargo run map (spec section 74, requirements 2550 to 2556): a lens of systems in bands, from one start system to one Buyer
// system. MapRules (Journey/MapRules.cs, spec 2414) sets Steps from Journey.RunSectorCount and FinalTier from Journey.FinalSectorTier
// just before a new galaxy is made. The numbers here only let the rules load. The other values are rules: a change needs a game
// restart and applies to new careers only.

HotCargoRun
{
	NameKey = "HotCargoJourney/MapSize"
	TipKey = "HotCargoJourney/MapSizeTip"
	MapGenerator
	{
		Spawners
		[
			{
				Type = HotCargoRunMap
				Steps = 6
				NameGenerator = &<./Data/name_generators/name_celestial.rules>
			}
			&<./Data/galaxy_map/map_generators/base_galaxy.rules>/Factions
			{
				Type = HotCargoRunMapTiers
				FinalTier = 12
				TierSpread = 2
				StartFaction = fringe
				StartSectorType = basic
			}
			&<../worlds/archetypes.rules>/SectorTypes // System archetypes (spec 220), instead of the vanilla weights.
		]
	}
}
